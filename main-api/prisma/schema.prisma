datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Roles aur Statuses ke Enums
enum Role {
  USER
  ADMIN
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

// Aapki requirement: Sirf CASH aur ONLINE
enum PaymentMode {
  CASH
  ONLINE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

// 2. User Model (Saari 8 mandatory fields ke saath)
model User {
  id             String         @id @default(uuid())
  name           String
  email          String         @unique
  phone          String
  gender         String         // MALE, FEMALE, ya OTHER
  address        String         // City ya local address
  qualification  String         // College/Degree
  passwordHash   String         // Encrypted password
  role           Role           @default(USER)        // Default hamesha USER
  accountStatus  AccountStatus  @default(PENDING)     // Default approval PENDING
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relations
  enrollments    Enrollment[]
  resetTokens    PasswordResetToken[]

  @@index([email])
}

// 3. Course Model
model Course {
  id          String       @id @default(uuid())
  name        String       @unique // e.g. "MERN Stack"
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())

  enrollments Enrollment[]
  mockTests   MockTest[]
}

// 4. Enrollment Model (Student + Course + Locked Fee)
model Enrollment {
  id             String          @id @default(uuid())
  userId         String
  courseId       String
  courseDuration String          // e.g. "6 Months"
  totalFee       Decimal         @db.Decimal(12, 2) // Approved official fee
  approvedAt     DateTime?
  approvedBy     String?         // Admin user ki ID
  createdAt      DateTime        @default(now())

  // Relations
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  course         Course          @relation(fields: [courseId], references: [id])
  payments       Payment[]
  testResults    MockTestResult[]

  @@unique([userId, courseId]) // Ek student ek course mein ek hi baar enroll ho sakta hai
}

// 5. Payment Model (Installments)
model Payment {
  id           String      @id @default(uuid())
  enrollmentId String
  amount       Decimal     @db.Decimal(12, 2)
  paymentDate  DateTime    @default(now())
  paymentMode  PaymentMode // CASH ya ONLINE
  note         String?     // Short admin remarks
  recordedBy   String      // Kis admin ne entry ki
  createdAt    DateTime    @default(now())

  enrollment   Enrollment  @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
}

// 6. Mock Test Model
model MockTest {
  id          String           @id @default(uuid())
  courseId    String
  title       String           // e.g. "JavaScript Basics Test"
  testDate    DateTime
  maxMarks    Int              @default(35) // Default 35 marks
  isPublished Boolean          @default(false)
  createdAt   DateTime         @default(now())

  course      Course           @relation(fields: [courseId], references: [id])
  results     MockTestResult[]
}

// 7. Mock Test Result Model (Bulk entry friendly)
model MockTestResult {
  id               String           @id @default(uuid())
  mockTestId       String
  enrollmentId     String
  marks            Decimal?         @db.Decimal(5, 2) // Null if absent
  attendanceStatus AttendanceStatus @default(PRESENT)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  mockTest         MockTest         @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  enrollment       Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([mockTestId, enrollmentId]) // Duplicate marks entry prevent karne ke liye
}

// 8. Background Email Outbox Model
model NotificationOutbox {
  id          String       @id @default(uuid())
  eventType   String       // e.g. "PAYMENT_RECORDED"
  payload     Json         // Email details data
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  createdAt   DateTime     @default(now())

  @@index([status])
}

// 9. Password Reset Model
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}